{
  "backbone": "efficientnet_b3",
  "pretrained": true,
  "feature_dim": 512,
  "slice_aggregation": "attention",
  "series_fusion": "attention",
  "dropout": 0.2,
  "in_channels": 3,
  
  "max_series": 4,
  "max_slices": 24,
  "slice_sampling": "uniform",
  "window_method": "percentile",
  "three_channel": true,
  "channel_method": "adjacent",
  
  "loss": "asymmetric",
  "loss_kwargs": {
    "gamma_neg": 4,
    "gamma_pos": 1,
    "clip": 0.05
  },
  
  "lr": 3e-4,
  "weight_decay": 1e-4,
  "epochs": 30,
  "scheduler": "cosine",
  "amp": true,
  "use_ema": true,
  "ema_decay": 0.999,
  "grad_clip": 1.0,
  
  "batch_size": 8,
  "num_workers": 4,
  "log_interval": 50,
  "save_interval": 5,
  "early_stopping": 15,
  
  "use_pseudo_labels": true,
  "pseudo_label_confidence": 0.85,
  "n_folds": 5,
  "seed": 42
}