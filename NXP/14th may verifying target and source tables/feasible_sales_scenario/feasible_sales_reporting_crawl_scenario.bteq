AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =96
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler
DELETE FROM vt_later_cumdemand_F  WHERE WEEK_COUNT > 96;


.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


INSERT INTO SC_PLANNING_BASE_T.FEASIBLE_SALES (
   REFERENCE_DATE
,PLAN_VERSION
,SALES_ORGANIZATION
,SALES_DOCUMENT_TYPE
,PLANNED_AVAILABLE_DATE
	,RUN_DATE
	,ENGINE_TYPE
	,END_ITEM
	,SHIP_TO
	,SOLD_TO
	,END_ORDER
	,END_LOCATION
	,PLANNED_DELIVERY_DATE  
	,REQUESTED_DELIVERY_DATE
	,CONFIRMED_DELIVERY_DATE
	,DEMAND_TYPE
	,PLANNED_QUANTITY  -- this Column
	,PLANNED_PRICE
	,PLANNED_VALUE     -- THIS COLUMN 
	,RLSSEC_AMPLEON
	,RLSSEC_STAR
	,RLSSEC_BL_CODE
	,ROW_CRTE_GMT_DTTM
	,ROW_CRTE_MST_DTTM
)

SELECT
DISTINCT 
(SELECT MAX(REFERENCE_DATE) FROM ENGINE_SET)  as REFERENCE_DATE
,'SCENARIO-7' AS PLAN_VERSION
,A5.SALES_ORGANIZATION
,NULL AS SALES_DOCUMENT_TYPE
,PRODUCTION_WEEK_BEGIN_DATE -7  AS PLANNED_AVAILABLE_DATE
,(SELECT MAX(RUN_DATE) FROM ENGINE_SET) AS RUN_DATE
,A.ENGINE_TYPE
,A.PART_12NC AS END_ITEM
,A.END_CUSTOMER_SHIP_TO AS SHIP_TO
,A.END_CUSTOMER_SOLD_TO AS SOLD_TO
,' ' AS END_ORDER
,A.CUSTOMER_RECEIVING_PLANT AS END_LOCATION
,PRODUCTION_WEEK_BEGIN_DATE AS PLANNED_DELIVERY_DATE
,PRODUCTION_WEEK_BEGIN_DATE AS REQUESTED_DELIVERY_DATE
,PRODUCTION_WEEK_BEGIN_DATE AS CONFIRMED_DELIVERY_DATE
,'NETSURPLUSFORECASTREQUEST' AS DEMAND_TYPE
,A.CONFIRMEDCRAWL AS PLANNED_QTY
,COALESCE(B3.FINAL_ASP,0) AS PLANNED_PRICE
,COALESCE(B3.FINAL_ASP,0)*A.CONFIRMEDCRAWL AS PLANNED_VALUE
,CASE WHEN mat.MAG_CODE IN ('R02','R58','RS4','RT6','RW6','RW8') THEN 'Y' ELSE 'N' END AS RLSSEC_AMPLEON
,CASE WHEN COALESCE(sales_indep.CUSTOMER_CACC_CODE, '#') IN ('APP','STA')   THEN 'Y'  ELSE 'N' END AS  RLSSEC_STAR
,COALESCE(MM.BUSINESS_LINE_CODE, '#') AS RLSSEC_BL_CODE
,((CURRENT_TIMESTAMP(0)) + INTERVAL '7' HOUR) AS ROW_CRTE_GMT_DTTM
,CURRENT_TIMESTAMP(0) AS ROW_CRTE_MST_DTTM
FROM vt_later_cumdemand_F A
	LEFT OUTER JOIN REFERENCE.MATERIAL_NXP_COLLECTION mat
		ON mat.PART_12NC = A.PART_12NC
	LEFT OUTER JOIN REFERENCE.MANAGEMENT_ORGANIZATION_MAG_MRU  mm
		ON mm.MAG_CODE = mat.MAG_CODE
		LEFT OUTER JOIN REFERENCE.CUSTOMER_SALES_INDEPENDENT_VIEW sales_indep
		ON sales_indep.CUSTOMER_CODE = A.END_CUSTOMER_SOLD_TO
		LEFT OUTER JOIN 
		 EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND CAL  ON (A.DATA_WEEK) = CAL.PRODUCTION_WEEK_AS_YYYYWW 
		 LEFT OUTER JOIN 
		 (
    SELECT 
        A1.RUN_DATE, 
        A1.PART_12NC,
        A1.SHIP_TO_CODE AS SHIP_TO ,
        A1.SOLD_TO_CODE AS SOLD_TO,
        A1.START_DATE,
        A1.COMPLETION_DATE, 
        MAX(CASE WHEN A1.FINAL_ASP>0 THEN A1.FINAL_ASP ELSE A1.NET_NET_PRICE END) AS FINAL_ASP
    FROM 
        EDW.SCP_FACT_TYPES_FOR_REPORTING A1
    WHERE 
        A1.RUN_DATE=(SELECT MAX(REFERENCE_DATE) FROM ENGINE_SET)
        AND A1.COMPLETION_DATE>(SELECT MAX(REFERENCE_DATE) FROM ENGINE_SET)
        AND (A1.FINAL_ASP+A1.NET_NET_PRICE)>0
    GROUP BY 
        1,2,3,4,5,6
) B3 ON
A.PART_12NC = B3.PART_12NC
    AND A.END_CUSTOMER_SHIP_TO=B3.SHIP_TO
    AND A.END_CUSTOMER_SOLD_TO=B3.SOLD_TO
	AND CAL.PRODUCTION_WEEK_BEGIN_DATE BETWEEN B3.START_DATE AND B3.COMPLETION_DATE
	 LEFT  OUTER JOIN 
(
              SELECT
                A1.SALES_ORG_CODE AS SALES_ORGANIZATION,
                A1.CUSTOMER_CODE AS SOLD_TO,
                A2.PARTNER_CODE AS SHIP_TO,
                A3.PARTNER_CODE AS ZC,
                A4.PARTNER_CODE AS ZD,
                A5.PLANT_CODE,
                A5.PLANT_NAME AS END_LOCATION,
                (ROW_NUMBER() OVER (PARTITION BY A5.PLANT_CODE ORDER BY A4.PARTNER_COUNTER)) AS COUNTER,
                CASE WHEN A6.LOCATION_TYPE='P:CSW' THEN 'Y' ELSE 'N' END AS IS_CSW
           FROM
               (
                SELECT
                     A1.SALES_ORG_CODE,
                     A1.CUSTOMER_CODE
                 FROM
                     REFERENCE.CUSTOMER_FUNCTION_NXP A1
                     INNER JOIN REFERENCE.CUSTOMER_SALES_VIEW A2 ON A1.CUSTOMER_CODE=A2.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A2.SALES_ORGANIZATION_CODE
                 WHERE
                     PARTNER_FUNCTION='AG'
                     AND A1.CUSTOMER_CODE=A1.PARTNER_CODE
                     AND A2.SALES_AREA_CUSTOMER_DELETE_FLAG IS NULL
                ) A1
            INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A2 ON A1.CUSTOMER_CODE=A2.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A2.SALES_ORG_CODE
            INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A3 ON A1.CUSTOMER_CODE=A3.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A3.SALES_ORG_CODE
            INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A4 ON A1.CUSTOMER_CODE=A4.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A4.SALES_ORG_CODE
            INNER JOIN REFERENCE.EIM_PLANT A5 ON A2.PARTNER_CODE=A5.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A5.SALES_ORGANIZATION
            LEFT OUTER JOIN ( SELECT * FROM EDW.SCP_LOCATION 
                              WHERE RUN_DATE=(SELECT MAX(RUN_DATE) AS CURRENT_RUN_DATE 
                                              FROM EDW.SCP_UDT_DEFAULTS_PER_SC_STAGE WHERE PLAN_VERSION='SCENARIO-7')
                              AND PLAN_VERSION='SCENARIO-7'
                                 ) A6 ON A5.PLANT_CODE=A6.LOCATION_CODE
            WHERE
                 IS_CSW='Y'
            AND A2.PARTNER_FUNCTION='WE'
            AND A3.PARTNER_FUNCTION='ZC'
            AND A4.PARTNER_FUNCTION='ZD'
            QUALIFY (ROW_NUMBER() OVER (PARTITION BY A5.PLANT_CODE ORDER BY A4.PARTNER_COUNTER))=1

) A5
ON a.END_CUSTOMER_SHIP_TO = A5.SHIP_TO
AND a.END_CUSTOMER_SOLD_TO = A5.SOLD_TO
WHERE A.CONFIRMEDCRAWL  > 0
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


DELETE FROM  SC_PLANNING_BASE_T.FEASIBLE_SALES WHERE PLANNED_QUANTITY =0 AND DEMAND_TYPE NOT IN ('Adjustment');

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler



*******************************************************************
* Error handlers
************************************************************************
**----------------
.LABEL NormalExit
**----------------
** Exit with no errors
**

   .REMARK "////Processing Complete Successfully ////"
    SELECT DATE,TIME;
   .QUIT

**------------------------
.LABEL SevereErrorHandler
**------------------------
**
** Exit on severe error
**

   .REMARK "////!!! ABORTING Process////"

.QUIT ERRORCODE;