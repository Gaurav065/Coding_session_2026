AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =92
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
WHERE B.part_12nc = A.part_12nc
AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =93
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
WHERE B.part_12nc = A.part_12nc
AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =94
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
WHERE B.part_12nc = A.part_12nc
AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =95
;
.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler

UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
