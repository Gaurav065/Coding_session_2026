AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =91
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
