,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT   
,CONSUMTION_QTY
,BUYER_STOCK_QUANTITY          
,CSWQTY                        
,DATA_WEEK                     
