C.PRODUCTION_WEEK_BEGIN_DATE = B.PRODUCTION_WEEK_END_DATE+1
) A
LEFT OUTER JOIN 
CP7DATA1 B
ON A.WEEK_COUNT+1 = B.WEEK_COUNT
AND A.PRODUCT_NAME = B.PRODUCT_NAME
AND A.SHIP_TO = B.SHIP_TO
AND A.SOLD_TO = B.SOLD_TO
AND A.ENGINE_TYPE = B.ENGINE_TYPE
WHERE A.WEEK_COUNT =94
AND B.WEEK_COUNT IS NULL
;
.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


INSERT INTO CP7DATA1
(
SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO          
,ISO_FENCE_WEEKS               
,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT   
,CONSUMTION_QTY
,BUYER_STOCK_QUANTITY          
,CSWQTY                        
,DATA_WEEK                     
,WEEK_COUNT                    
,SOLD_TO                       
,SHIP_TO                       
,ENGINE_TYPE                   
,CUM_NET_EXPIRED_QTY
,PRODUCT_NAME
,NET_EXPIRED_FINAL_FORECAST
)
SELECT 
A.SNAPSHOT_DATE                 
,A.SNAPSHOT_WEEK                 
,A.SALES_ORGANIZATION            
,A.END_CUSTOMER_SHIP_TO          
,A.END_CUSTOMER_SOLD_TO          
,A.ISO_FENCE_WEEKS               
,A.FROZEN_FENCE_WEEKS            
,A.STATIC_HORIZON                
,A.DYNAMIC_HORIZON               
,A.CUSTOMER_RECEIVING_PLANT   
,A.CONSUMTION_QTY
,A.BUYER_STOCK_QUANTITY          
,A.CSWQTY                        
,A.NEXT_WEEK AS DATA_WEEK                     
,A.WEEK_COUNT+1                    
,A.SOLD_TO                       
,A.SHIP_TO                       
,A.ENGINE_TYPE                   
,A.CUM_NET_EXPIRED_QTY
,A.PRODUCT_NAME
,0 AS NET_EXPIRED_FINAL_FORECAST

FROM 
(
SELECT A.*,C.PRODUCTION_WEEK_AS_YYYYWW AS NEXT_WEEK FROM CP7DATA1 A
INNER JOIN 
(SELECT PRODUCTION_WEEK_END_DATE,PRODUCTION_WEEK_AS_YYYYWW FROM  EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND GROUP BY 1, 2) B
ON 
A.DATA_WEEK = B.PRODUCTION_WEEK_AS_YYYYWW
INNER JOIN 
(SELECT PRODUCTION_WEEK_BEGIN_DATE,PRODUCTION_WEEK_AS_YYYYWW FROM  EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND GROUP BY 1, 2) C 
ON 
C.PRODUCTION_WEEK_BEGIN_DATE = B.PRODUCTION_WEEK_END_DATE+1
) A
LEFT OUTER JOIN 
CP7DATA1 B
ON A.WEEK_COUNT+1 = B.WEEK_COUNT
AND A.PRODUCT_NAME = B.PRODUCT_NAME
AND A.SHIP_TO = B.SHIP_TO
AND A.SOLD_TO = B.SOLD_TO
AND A.ENGINE_TYPE = B.ENGINE_TYPE
WHERE A.WEEK_COUNT =95
AND B.WEEK_COUNT IS NULL
;
.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


INSERT INTO CP7DATA1
(
SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO          
,ISO_FENCE_WEEKS               
