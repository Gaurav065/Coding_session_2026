CREATE MULTISET VOLATILE  TABLE CP7DATA1 AS
(
SELECT 
M.SNAPSHOT_DATE,
M.SNAPSHOT_WEEK,
M.SALES_ORGANIZATION            
,M.END_CUSTOMER_SHIP_TO          
,M.END_CUSTOMER_SOLD_TO  
,M.ISO_FENCE_WEEKS               
,M.FROZEN_FENCE_WEEKS            
,M.STATIC_HORIZON                
,M.DYNAMIC_HORIZON               
,M.CUSTOMER_RECEIVING_PLANT      
,M.CONSUMTION_QTY                
,M.BUYER_STOCK_QUANTITY          
,M.CSWQTY  
,DATA_WEEK
,WEEK_COUNT
,M.SOLD_TO                       
,M.SHIP_TO  
,M.ENGINE_TYPE
, SUM(COALESCE(M.NET_EXPIRED_FINAL_FORECAST,0)) OVER (PARTITION BY M.RUN_DATE, M.PRODUCT_NAME, M.SHIP_TO, M.SOLD_TO, M.ENGINE_TYPE  ORDER BY M.DATA_WEEK  
		  ROWS UNBOUNDED PRECEDING) AS CUM_NET_EXPIRED_QTY
,M.PRODUCT_NAME
,COALESCE(M.NET_EXPIRED_FINAL_FORECAST,0) as NET_EXPIRED_FINAL_FORECAST
		  FROM
(
SELECT DISTINCT A.*, A3.PRODUCTION_WEEK_AS_YYYYWW,((A31.PRODUCTION_WEEK_BEGIN_DATE- A2.PRODUCTION_WEEK_BEGIN_DATE)/7) AS WEEK_COUNT,
      	  A31.PRODUCTION_WEEK_AS_YYYYWW AS DATA_WEEK  , D.SNAPSHOT_DATE,D.SNAPSHOT_WEEK,
		  D.SALES_ORGANIZATION            
,D.END_CUSTOMER_SHIP_TO          
,D.END_CUSTOMER_SOLD_TO  
,D.ISO_FENCE_WEEKS               
,D.FROZEN_FENCE_WEEKS            
,D.STATIC_HORIZON                
,D.DYNAMIC_HORIZON               
,D.CUSTOMER_RECEIVING_PLANT      
,D.CONSUMTION_QTY                
,D.BUYER_STOCK_QUANTITY          
,D.CSWQTY  
		  FROM    SC_PLANNING.SCP_FORECAST_TRANSFORMATION  A 
INNER JOIN 
EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND A3 ON A3.PRODUCTION_DATE = A.EFFECTIVE_FROM_DATE+8  
INNER JOIN 
(SELECT DISTINCT SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,A.SOLD_TO                       
,A.SHIP_TO       
,PART_12NC
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO  
,ISO_FENCE_WEEKS               
,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT      
,CONSUMTION_QTY                
,BUYER_STOCK_QUANTITY          
,CSWQTY    
FROM
CP7DATA A
)D
ON 
D.SHIP_TO = A.SHIP_TO
AND D.SOLD_TO = A.SOLD_TO
AND D.PART_12NC = A.PRODUCT_NAME
      LEFT OUTER JOIN EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND A2 ON D.SNAPSHOT_DATE = A2.PRODUCTION_DATE 
      LEFT OUTER JOIN EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND A31 ON A.EFFECTIVE_FROM_DATE+8=A31.PRODUCTION_DATE
WHERE A.RUN_DATE =(SELECT RUN_DATE FROM VERSION_DATE)
AND WEEK_COUNT > D.STATIC_HORIZON AND A.PLAN_VERSION='SCENARIO-7'
) M
)  WITH DATA ON COMMIT PRESERVE ROWS
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler

INSERT INTO CP7DATA1
(
SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO          
,ISO_FENCE_WEEKS               
,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT   
,CONSUMTION_QTY
,BUYER_STOCK_QUANTITY          
,CSWQTY                        
,DATA_WEEK                     
,WEEK_COUNT                    
,SOLD_TO                       
,SHIP_TO                       
,ENGINE_TYPE                   
,CUM_NET_EXPIRED_QTY
,PRODUCT_NAME
,NET_EXPIRED_FINAL_FORECAST
)
SELECT 
A.SNAPSHOT_DATE                 
,A.SNAPSHOT_WEEK                 
,A.SALES_ORGANIZATION            
,A.END_CUSTOMER_SHIP_TO          
,A.END_CUSTOMER_SOLD_TO          
,A.ISO_FENCE_WEEKS               
,A.FROZEN_FENCE_WEEKS            
,A.STATIC_HORIZON                
,A.DYNAMIC_HORIZON               
,A.CUSTOMER_RECEIVING_PLANT   
,A.CONSUMTION_QTY
,A.BUYER_STOCK_QUANTITY          
,A.CSWQTY                        
,A.NEXT_WEEK AS DATA_WEEK                     
,A.WEEK_COUNT+1                    
,A.SOLD_TO                       
,A.SHIP_TO                       
,A.ENGINE_TYPE                   
,A.CUM_NET_EXPIRED_QTY
,A.PRODUCT_NAME
,0 AS NET_EXPIRED_FINAL_FORECAST
FROM 
(
SELECT A.*,C.PRODUCTION_WEEK_AS_YYYYWW AS NEXT_WEEK FROM CP7DATA1 A
INNER JOIN 
(SELECT PRODUCTION_WEEK_END_DATE,PRODUCTION_WEEK_AS_YYYYWW FROM  EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND GROUP BY 1, 2) B
ON 
A.DATA_WEEK = B.PRODUCTION_WEEK_AS_YYYYWW
INNER JOIN 
(SELECT PRODUCTION_WEEK_BEGIN_DATE,PRODUCTION_WEEK_AS_YYYYWW FROM  EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND GROUP BY 1, 2) C 
ON 
C.PRODUCTION_WEEK_BEGIN_DATE = B.PRODUCTION_WEEK_END_DATE+1
) A
LEFT OUTER JOIN 
CP7DATA1 B
ON A.WEEK_COUNT+1 = B.WEEK_COUNT
AND A.PRODUCT_NAME = B.PRODUCT_NAME
AND A.SHIP_TO = B.SHIP_TO
AND A.SOLD_TO = B.SOLD_TO
AND A.ENGINE_TYPE = B.ENGINE_TYPE
WHERE A.WEEK_COUNT =1
AND B.WEEK_COUNT IS NULL
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler

INSERT INTO CP7DATA1
(
SNAPSHOT_DATE                 
