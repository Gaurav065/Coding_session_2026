INSERT INTO CP7DATA
(
SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO          
,ISO_FENCE_WEEKS               
,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT   
,CONSUMTION_QTY
,BUYER_STOCK_QUANTITY          
,CSWQTY                        
,DATA_WEEK                     
,WEEK_COUNT                    
,SOLD_TO                       
,SHIP_TO                       
,ENGINE_TYPE                   
,CUM_NET_EXPIRED_QTY
,PART_12NC

)
SELECT
SNAPSHOT_DATE                 
,SNAPSHOT_WEEK                 
,SALES_ORGANIZATION            
,END_CUSTOMER_SHIP_TO          
,END_CUSTOMER_SOLD_TO          
,ISO_FENCE_WEEKS               
,FROZEN_FENCE_WEEKS            
,STATIC_HORIZON                
,DYNAMIC_HORIZON               
,CUSTOMER_RECEIVING_PLANT   
,CONSUMTION_QTY
,BUYER_STOCK_QUANTITY          
,CSWQTY                        
,DATA_WEEK                     
,WEEK_COUNT                    
,SOLD_TO                       
,SHIP_TO                       
,ENGINE_TYPE                   
,CUM_NET_EXPIRED_QTY
,PRODUCT_NAME
FROM CP7DATA1;

UPDATE A FROM CP7DATA A,
(
SELECT B.CUM_DEMAND AS CUM_DEMAND_OLD1, (A.CUM_NET_EXPIRED_QTY+ B.CUM_DEMAND) AS CUM_DEMAND_NET_FLEX, A.* 
FROM  (SELECT * FROM CP7DATA WHERE  WEEK_COUNT > STATIC_HORIZON )   A 
INNER JOIN 
(
SELECT * FROM CP7DATA  WHERE  
WEEK_COUNT = STATIC_HORIZON  
)B
ON 
A.PART_12NC = B.PART_12NC
AND A.END_CUSTOMER_SHIP_TO = B.END_CUSTOMER_SHIP_TO
AND A.END_CUSTOMER_SOLD_TO = B.END_CUSTOMER_SOLD_TO
AND A.ENGINE_TYPE = B.ENGINE_TYPE
) K
SET CUM_DEMAND = K.CUM_DEMAND_NET_FLEX
WHERE 
A.PART_12NC = K.PART_12NC
AND A.END_CUSTOMER_SHIP_TO = K.END_CUSTOMER_SHIP_TO
AND A.END_CUSTOMER_SOLD_TO = K.END_CUSTOMER_SOLD_TO
AND A.ENGINE_TYPE = K.ENGINE_TYPE
AND A.WEEK_COUNT = K.WEEK_COUNT
AND A.DATA_WEEK = K.DATA_WEEK
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler



DELETE FROM CP7DATA WHERE SHIP_TO IS NULL;
DELETE FROM CP7DATA WHERE CHARACTERS(TRIM(ENGINE_TYPE)) =0;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler




/*PMAD */

CREATE MULTISET VOLATILE  TABLE  PMAD AS
(   
 SELECT
 PART_12NC AS PRODUCT_NAME,
 ENGINE_TYPE,
 SHIP_TO,
 SOLD_TO,
 PRODUCTION_WEEK_AS_YYYYWW,
 SUM(PLANNED_QUANTITY) AS PLANNED_QTY
 FROM
 ( 
 SELECT 
A1.REFERENCE_DATE
,A1.PLAN_VERSION
,A1.SALES_ORGANIZATION
,A1.SALES_DOCUMENT_TYPE
,A1.PLANNED_AVAILABLE_DATE
,A1.RUN_DATE
,A1.ENGINE_TYPE
,A1.END_ITEM AS PART_12NC
,A1.SHIP_TO
,A1.SOLD_TO
,A1.END_ORDER
,A1.END_LOCATION
,A1.PLANNED_DELIVERY_DATE
,A1.REQUESTED_DELIVERY_DATE
,CAL.PRODUCTION_WEEK_AS_YYYYWW
,A1.CONFIRMED_DELIVERY_DATE
,A1.DEMAND_TYPE
,A1.PLANNED_QUANTITY
,A1.PLANNED_PRICE
,A1.PLANNED_VALUE
,A1.RLSSEC_AMPLEON
,A1.RLSSEC_STAR
,A1.RLSSEC_BL_CODE
,A1.ROW_CRTE_GMT_DTTM
,A1.ROW_CRTE_MST_DTTM
FROM 
(SELECT * FROM SC_PLANNING.FEASIBLE_SALES WHERE DEMAND_TYPE ='NETSURPLUSFORECASTREQUEST' AND RUN_DATE IN (SELECT RUN_DATE FROM VERSION_DATE)  ) A1
INNER  JOIN EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND CAL  ON (A1.PLANNED_DELIVERY_DATE+interval '7' day) = CAL.PRODUCTION_DATE 
INNER JOIN
                (
                SELECT 
                    DISTINCT SNAPSHOT_DATE ,SHIP_TO, SOLD_TO, PART_12NC, CUSTOMER_PROGRAM_LABEL,  ISO_FENCE_WEEKS,
                             FROZEN_FENCE_WEEKS,  STATIC_HORIZON, DYNAMIC_HORIZON 
                FROM 
                    SC_PLANNING.CUSTOMER_PROGRAM_FORECAST_MASTER
                WHERE 
                    SNAPSHOT_DATE=(SELECT MAX(SNAPSHOT_DATE) FROM SC_PLANNING.CUSTOMER_PROGRAM_FORECAST_MASTER)
                AND CUSTOMER_PROGRAM_LABEL IN ('CP7','CP8')
                AND FORECAST_MASTER_VALID_FROM_DATE <= SNAPSHOT_DATE
                AND FORECAST_MASTER_VALID_TO_DATE >= SNAPSHOT_DATE
                AND ACTIVE_CUSTOMER_PROGRAM_FLAG ='Y'
                ) A3 
				ON 
 A1.END_ITEM =A3.PART_12NC  AND A1.SOLD_TO = A3.SOLD_TO AND A1.SHIP_TO =A3.SHIP_TO
 ) X
 GROUP BY 
  PART_12NC,
 ENGINE_TYPE,
 SHIP_TO,
 SOLD_TO,
 PRODUCTION_WEEK_AS_YYYYWW
)  WITH DATA ON COMMIT PRESERVE ROWS
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler




/* Goods In transit Logic */

CREATE MULTISET VOLATILE TABLE  GIT AS
(  
SELECT
    A1.SALES_ORGANIZATION,
    A1.SALES_DOCUMENT_TYPE,        
    A1.SALES_ORDER,
    A1.SALES_ORDER_ITEM,
    A2.SOLD_TO,
    A2.SHIP_TO,
    A1.PART_12NC,
    A1.CUSTOMER_REFERENCE_QUALIFIER,
    A3.ZC,
    A3.ZD,
    A3.PLANT_CODE,
    A3.PLANT_NAME,
    A1.ORDER_QUANTITY,
    (A1.ORDER_QUANTITY-A1.GI_QTY) AS OPEN_QTY,
    A1.GI_QTY,
    A1.GR_QTY,
    (A1.GI_QTY-A1.GR_QTY) AS GIT_QTY
FROM
(
    SELECT
        A1.SALES_ORGANISATION as SALES_ORGANIZATION,
        A1.SALES_DOCUMENT_TYPE,        
        A1.SALES_ORDER,
        A2.SALES_ORDER_ITEM,
        A2.PART_12NC,
        A2.CUSTOMER_REFERENCE_QUALIFIER,
        MAX(A2.CUMULATIVE_ORDER_QUANTITY) AS ORDER_QUANTITY,
        SUM(CASE WHEN A4.MOVEMENT_TYPE='601' THEN QUANTITY_ENTERED ELSE 0 END) AS GI_QTY,
        SUM(CASE WHEN A4.MOVEMENT_TYPE='305' THEN QUANTITY_ENTERED ELSE 0 END) AS GR_QTY   
    FROM
        SC_PLANNING.SALES_ORDER_HEADER A1
        INNER JOIN SC_PLANNING.SALES_ORDER_ITEM A2 ON A1.SALES_ORDER=A2.SALES_ORDER 
        LEFT OUTER JOIN SC_PLANNING.DELIVERY_ITEM A3 ON A1.SALES_ORDER=A3.SALES_ORDER AND A2.SALES_ORDER_ITEM=A3.SALES_ORDER_ITEM
        LEFT OUTER JOIN SC_PLANNING.MATERIAL_MOVEMENTS A4 ON A3.DELIVERY_DOCUMENT=A4.DELIVERY_DOCUMENT AND A3.DELIVERY_LINE_ITEM_NUM=A4.DELIVERY_ITEM
    WHERE
        A1.SALES_DOCUMENT_TYPE='ZISO' --IN ('ZCMC','ZISO')
        AND (A4.MOVEMENT_TYPE IN ('601','305') OR A4.MOVEMENT_TYPE IS NULL)
        --AND A2.SALES_ORDER='0031571640'
    GROUP BY 1,2,3,4,5,6
    HAVING GR_QTY<ORDER_QUANTITY
) A1
LEFT OUTER JOIN SC_PLANNING.SALES_ORDER_PARTNER A2 ON A1.SALES_ORDER=A2.SALES_ORDER AND A1.SALES_ORDER_ITEM=A2.SALES_ORDER_ITEM
LEFT OUTER JOIN 
(
    SELECT
        A1.SALES_ORG_CODE AS SALES_ORGANIZATION,
        A1.CUSTOMER_CODE AS SOLD_TO,
        A2.PARTNER_CODE AS SHIP_TO,
        A3.PARTNER_CODE AS ZC,
        A4.PARTNER_CODE AS ZD,
        A5.PLANT_CODE,
        A5.PLANT_NAME,
        (ROW_NUMBER() OVER (PARTITION BY A5.PLANT_CODE ORDER BY A4.PARTNER_COUNTER)) AS COUNTER,
        CASE WHEN A6.LOCATION_TYPE='P:CSW' THEN 'Y' ELSE 'N' END AS IS_CSW
    FROM
        (
            SELECT
                A1.SALES_ORG_CODE,
                A1.CUSTOMER_CODE
            FROM
                REFERENCE.CUSTOMER_FUNCTION_NXP A1
                INNER JOIN REFERENCE.CUSTOMER_SALES_VIEW A2 ON A1.CUSTOMER_CODE=A2.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A2.SALES_ORGANIZATION_CODE
            WHERE
                PARTNER_FUNCTION='AG'
                AND A1.CUSTOMER_CODE=A1.PARTNER_CODE
                AND A2.SALES_AREA_CUSTOMER_DELETE_FLAG IS NULL
        ) A1
        INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A2 ON A1.CUSTOMER_CODE=A2.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A2.SALES_ORG_CODE AND A2.PARTNER_FUNCTION='WE'
        INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A3 ON A1.CUSTOMER_CODE=A3.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A3.SALES_ORG_CODE AND A3.PARTNER_FUNCTION='ZC'
        INNER JOIN REFERENCE.CUSTOMER_FUNCTION_NXP A4 ON A1.CUSTOMER_CODE=A4.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A4.SALES_ORG_CODE AND A4.PARTNER_FUNCTION='ZD'
        INNER JOIN REFERENCE.EIM_PLANT A5 ON A2.PARTNER_CODE=A5.CUSTOMER_CODE AND A1.SALES_ORG_CODE=A5.SALES_ORGANIZATION
        LEFT OUTER JOIN ( SELECT * FROM EDW.SCP_LOCATION WHERE RUN_DATE=(SELECT MAX(RUN_DATE) AS CURRENT_RUN_DATE FROM EDW.SCP_UDT_DEFAULTS_PER_SC_STAGE WHERE PLAN_VERSION='SCENARIO-7')) A6 ON A5.PLANT_CODE=A6.LOCATION_CODE
    WHERE
        IS_CSW='Y' 
    QUALIFY (ROW_NUMBER() OVER (PARTITION BY A5.PLANT_CODE ORDER BY A4.PARTNER_COUNTER))=1
) A3 ON A1.SALES_ORGANIZATION=A3.SALES_ORGANIZATION AND A2.SOLD_TO=A3.SOLD_TO AND A2.SHIP_TO=A3.SHIP_TO
)  WITH DATA ON COMMIT PRESERVE ROWS
;


.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler



CREATE MULTISET VOLATILE   TABLE vt_later_cumdemand 
AS
(	
SELECT
A.* ,  CASE WHEN A.WEEK_COUNT =1 THEN CSWQTY_F+ISO_QTY+COALESCE(PLANNED_QTY,0)+GIT_QTY ELSE COALESCE(ISO_QTY,0)+COALESCE(PLANNED_QTY,0) END AS C_SUPPLY 

FROM
(
SELECT
DISTINCT A.*,   COALESCE(B.CUM_DEMAND,0) AS ISO_QTY, c.PLANNED_QTY,  GIT_QTY  ,  A.CSWQTY   AS CSWQTY_F

FROM CP7DATA A
LEFT OUTER JOIN 
(SELECT * FROM PLANNEDISO)  B
ON 
A.PART_12NC = B.PART_12NC
AND A.SHIP_TO = B.SHIP_TO
AND A.SOLD_TO = B.SOLD_TO
AND b.PRODUCTION_WEEK_AS_YYYYWW = DATA_WEEK 
AND A.ENGINE_TYPE = B.ENGINE_TYPE
--AND ENGINE_TYPE='H'
LEFT OUTER JOIN
(SELECT * FROM PMAD  ) C
ON 
C.PRODUCT_NAME = A.PART_12NC
AND A.SHIP_TO = C.SHIP_TO
AND A.SOLD_TO = C.SOLD_TO
AND C.PRODUCTION_WEEK_AS_YYYYWW = A.DATA_WEEK
AND A.ENGINE_TYPE = C.ENGINE_TYPE
LEFT OUTER JOIN (
SELECT PART_12NC, SHIP_TO, SOLD_TO,ZC,ZD, SUM(GIT_QTY) AS GIT_QTY  FROM GIT WHERE CUSTOMER_REFERENCE_QUALIFIER IS NULL
GROUP BY 1,2,3,4,5
)GIT
ON 
A.PART_12NC = GIT.PART_12NC
AND A.SHIP_TO = GIT.SHIP_TO
AND A.SOLD_TO = GIT.SOLD_TO
) A
) WITH DATA ON COMMIT PRESERVE ROWS
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A  
FROM	vt_later_cumdemand  A ,
(
SELECT	* 
FROM	PLANNEDISO 
WHERE	PRODUCTION_WEEK_AS_YYYYWW IN (
SELECT PRODUCTION_WEEK_AS_YYYYWW FROM EIM_REFERENCE.CALENDAR_FISCAL_PRODUCTION_BLEND WHERE PRODUCTION_DATE 
=(SELECT REFERENCE_DATE FROM VERSION_DATE)
)
 )   B
 SET ISO_QTY = A.ISO_QTY + B.CUM_DEMAND
WHERE  A.PART_12NC = B.PART_12NC
	AND A.SHIP_TO = B.SHIP_TO
	AND A.SOLD_TO = B.SOLD_TO
	AND A.ENGINE_TYPE = B.ENGINE_TYPE
	AND A.WEEK_COUNT =1;


.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


CREATE MULTISET VOLATILE   TABLE vt_later_cumdemand_N 
AS
(
SELECT A.* ,  SUM(A.ISO_QTY) OVER(PARTITION BY A.Snapshot_Date, A.Part_12nc, A.SHIP_TO, A.SOLD_TO, A.ENGINE_TYPE
  					    ORDER BY A.DATA_WEEK ROWS UNBOUNDED PRECEDING)  AS CUM_ISO , 
												SUM(COALESCE(A.PLANNED_QTY,0)) OVER(PARTITION BY A.Snapshot_Date, A.Part_12nc, A.SHIP_TO, A.SOLD_TO, A.ENGINE_TYPE
  					    ORDER BY A.DATA_WEEK ROWS UNBOUNDED PRECEDING)  AS CUM_Planned  FROM vt_later_cumdemand A

)  WITH DATA ON COMMIT PRESERVE ROWS
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE vt_later_cumdemand_N
SET C_SUPPLY = CUM_ISO+CUM_Planned+GIT_QTY+CSWQTY_F
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler







CREATE MULTISET VOLATILE   TABLE vt_later_cumdemand_f
AS
(	
SELECT A.*, CASE WHEN (C_SUPPLY < CUM_DEMAND) OR (C_SUPPLY = CUM_DEMAND) THEN C_SUPPLY ELSE   CUM_DEMAND END AS MINVALUE,
CASE WHEN (C_SUPPLY < CUM_DEMAND) OR (C_SUPPLY = CUM_DEMAND) THEN C_SUPPLY ELSE   CUM_DEMAND END AS CONFIRMEDCRAWL FROM vt_later_cumdemand_N A
) WITH DATA ON COMMIT PRESERVE ROWS
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE vt_later_cumdemand_F
SET CONFIRMEDCRAWL =MINVALUE
WHERE WEEK_COUNT =1;


.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
WHERE B.part_12nc = A.part_12nc
AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =2
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


UPDATE A FROM  vt_later_cumdemand_F  A, vt_later_cumdemand_F B
SET CONFIRMEDCRAWL = A.MINVALUE - B.MINVALUE
WHERE B.part_12nc = A.part_12nc
AND B.END_CUSTOMER_SHIP_TO = A.END_CUSTOMER_SHIP_TO
AND B.END_CUSTOMER_SOLD_TO=A.END_CUSTOMER_SOLD_TO 
AND A.WEEK_COUNT - 1 = B.WEEK_COUNT
AND COALESCE(A.ENGINE_TYPE,'X') = COALESCE(B.ENGINE_TYPE,'X')
AND A.WEEK_COUNT =3
;

.IF ERRORCODE <> 0 THEN GOTO SevereErrorHandler


