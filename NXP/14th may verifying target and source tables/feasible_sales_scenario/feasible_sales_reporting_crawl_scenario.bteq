,CSWQTY                        
,DATA_WEEK                     
,WEEK_COUNT                    
,SOLD_TO                       
,SHIP_TO                       
,ENGINE_TYPE                   
,CUM_NET_EXPIRED_QTY
,PRODUCT_NAME
,NET_EXPIRED_FINAL_FORECAST
)
SELECT 
A.SNAPSHOT_DATE                 
,A.SNAPSHOT_WEEK                 
,A.SALES_ORGANIZATION            
,A.END_CUSTOMER_SHIP_TO          
,A.END_CUSTOMER_SOLD_TO          
,A.ISO_FENCE_WEEKS               
,A.FROZEN_FENCE_WEEKS            
,A.STATIC_HORIZON                
,A.DYNAMIC_HORIZON               
,A.CUSTOMER_RECEIVING_PLANT   
,A.CONSUMTION_QTY
,A.BUYER_STOCK_QUANTITY          
